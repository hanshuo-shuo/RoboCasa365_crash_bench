#!/usr/bin/env bash
# Copy to setup/.robocasa_foundation_paths.sh and edit locally. Never commit it.

ROBOCASA_FOUNDATION_ENV=/projects/p33100/siosio/envs/robocasa-foundation
ROBOCASA_ROOT=/projects/p33100/siosio/third_party/robocasa365
ROBOSUITE_ROOT=/projects/p33100/siosio/third_party/robosuite
ROBOCASA_ASSET_DIR=/projects/p33100/siosio/third_party/robocasa365/robocasa/models/assets
ROBOCASA_DATA_ROOT=/projects/p33100/siosio/robocasa_datasets
PIP_CACHE_DIR=/projects/p33100/siosio/pip_cache
CONDA_PKGS_DIRS=/projects/p33100/siosio/conda_pkgs

ROBOCASA_RUN_ROOT=/projects/p33100/siosio/robocasa_foundation_runs
ROBOCASA_READER_ROOT=/projects/p33100/siosio/tools/pyarrow-21.0.0

# Optional single-model pilot; pinned source/checkpoint prepared outside Git.
# ROBOCASA_PI05_ROOT=/external/tools/robocasa-pi05-pilot
# ROBOCASA_PI05_PYTHON=/existing/read-only/openpi/bin/python
# OPENPI_DATA_HOME=/existing/openpi_assets

# Optional paper_v1 second policy. Use a new isolated inference prefix;
# never install its dependencies into existing model/simulator environments.
# ROBOCASA_GR00T_ROOT=/external/tools/robocasa-gr00t-paper
# ROBOCASA_GR00T_ENV=/external/envs/robocasa-gr00t-paper
